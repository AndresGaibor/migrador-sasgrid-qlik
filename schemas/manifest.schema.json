{
  "$defs": {
    "FileKind": {
      "enum": [
        "sas",
        "shell",
        "log",
        "doc",
        "other"
      ],
      "title": "FileKind",
      "type": "string"
    },
    "Skipped": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "title": "Skipped",
      "type": "object"
    },
    "SourceFile": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/FileKind"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoding"
        }
      },
      "required": [
        "path",
        "sha256",
        "size",
        "kind"
      ],
      "title": "SourceFile",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/SourceFile"
      },
      "title": "Files",
      "type": "array"
    },
    "skipped": {
      "items": {
        "$ref": "#/$defs/Skipped"
      },
      "title": "Skipped",
      "type": "array"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "Manifest",
  "type": "object"
}
