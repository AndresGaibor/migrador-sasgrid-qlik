# Talend MCP (opcional; el análisis SAS no depende de él). Solo lectura por defecto.
TALEND_MCP_URL=http://127.0.0.1:3927/mcp
TALEND_MCP_READONLY=true
# Persistencia local
SGM_DATA_DIR=./data
# Límites de importación (entrada no confiable)
SGM_MAX_FILE_BYTES=5242880
SGM_MAX_FILES=5000
# Si se define, la API solo importa desde estas rutas (separadas por ':'). Recomendado si la API no es solo local.
# SGM_IMPORT_ROOTS=/srv/sas-import
