# Talend MCP (opcional; el análisis SAS no depende de él). Escribe solo desde el botón por Job.
TALEND_MCP_URL=http://127.0.0.1:3927/mcp
TALEND_MCP_TIMEOUT_SECONDS=60
TALEND_MCP_READONLY=false
TALEND_APPLY_FOLDER=Process/PruebasWebSAS
# Persistencia local
SGM_DATA_DIR=./data
# Límites de importación (entrada no confiable)
SGM_MAX_FILE_BYTES=5242880
SGM_MAX_FILES=5000
SGM_MAX_TOTAL_BYTES=268435456
# API local de una instancia: trabajos activos y cola en memoria del proceso.
SGM_MAX_PIPELINE_CONCURRENCY=2
SGM_MAX_QUEUED_PIPELINES=20
# Si se define, la API solo importa desde estas rutas (separadas por ':'). Recomendado si la API no es solo local.
# SGM_IMPORT_ROOTS=/srv/sas-import
