[Unit]
Description=SAS Grid Migrator (API + UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/code/javascript/migrador-sasgrid-qlik
# Datos en /var/lib/sgm (StateDirectory); la API solo importa desde /var/lib/sgm/imports
StateDirectory=sgm
StateDirectoryMode=0700
UMask=0077
Environment=SGM_DATA_DIR=/var/lib/sgm/data
Environment=SGM_IMPORT_ROOTS=/var/lib/sgm/imports
Environment=PYTHONDONTWRITEBYTECODE=1
# Solo 127.0.0.1: el acceso remoto es por Tailscale Serve (sgm-tailscale-serve.service)
ExecStart=/home/ubuntu/code/javascript/migrador-sasgrid-qlik/.venv/bin/uvicorn apps.api.main:app --host 127.0.0.1 --port 38421
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
